#!/bin/sh
set -eu
[ "$#" -eq 1 ] && [ -f "$1" ] || { printf '%s\n' 'Usage: commit-msg <message-file>' >&2; exit 1; }
HANNES_COMMIT_MESSAGE=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
export HANNES_COMMIT_MESSAGE
cd "$(git rev-parse --show-toplevel)"
command -v python3 >/dev/null 2>&1 || { printf '%s\n' 'Python 3.11+ is required. Run mise install before committing.' >&2; exit 1; }
exec python3 scripts/run-gate.py commit-msg
