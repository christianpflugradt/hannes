{
  "checks": {
    "format": {
      "id": "format",
      "description": "Verify Rust formatting",
      "enabled": true,
      "command": [
        "cargo",
        "+stable",
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "timeout_seconds": 120,
      "run_at": [
        "pre-commit",
        "pre-push",
        "check",
        "release-build"
      ]
    },
    "docs": {
      "id": "docs",
      "description": "Validate documentation links and specification references",
      "enabled": true,
      "command": [
        "python3",
        "scripts/check-docs.py"
      ],
      "timeout_seconds": 60,
      "run_at": [
        "pre-commit",
        "pre-push",
        "check"
      ]
    },
    "python-tests": {
      "id": "python-tests",
      "description": "Test Python helpers and repository integration",
      "enabled": true,
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts",
        "-p",
        "test_*.py"
      ],
      "timeout_seconds": 300,
      "run_at": [
        "pre-push",
        "check"
      ]
    },
    "agents-size": {
      "id": "agents-size",
      "description": "Limit AGENTS.md to 1200 ASCII-whitespace-separated words",
      "enabled": true,
      "command": [
        "python3",
        "scripts/check-word-count.py",
        "AGENTS.md",
        "1200"
      ],
      "timeout_seconds": 30,
      "run_at": [
        "pre-commit",
        "pre-push",
        "check"
      ]
    },
    "release-rules": {
      "id": "release-rules",
      "description": "Test semantic release rules and lifecycle",
      "enabled": true,
      "command": [
        "npm",
        "--offline",
        "test"
      ],
      "timeout_seconds": 180,
      "run_at": [
        "pre-push",
        "check"
      ]
    },
    "clippy": {
      "id": "clippy",
      "description": "Lint Rust with warnings denied",
      "enabled": true,
      "command": [
        "cargo",
        "+stable",
        "--offline",
        "clippy",
        "--all-targets",
        "--locked",
        "--",
        "-D",
        "warnings"
      ],
      "timeout_seconds": 600,
      "run_at": [
        "pre-push",
        "check",
        "release-build"
      ]
    },
    "rust-tests": {
      "id": "rust-tests",
      "description": "Run unit acceptance documentation and compatibility tests",
      "enabled": true,
      "command": [
        "cargo",
        "+stable",
        "--offline",
        "test",
        "--locked"
      ],
      "timeout_seconds": 600,
      "run_at": [
        "pre-push",
        "check",
        "release-build"
      ]
    },
    "native-build": {
      "id": "native-build",
      "description": "Build the candidate native release executable",
      "enabled": true,
      "command": [
        "cargo",
        "+stable",
        "build",
        "--release",
        "--locked",
        "--offline"
      ],
      "timeout_seconds": 600,
      "run_at": [
        "pre-push",
        "check",
        "release-build"
      ]
    },
    "native-smoke": {
      "id": "native-smoke",
      "description": "Smoke-test the candidate executable",
      "enabled": true,
      "command": [
        "python3",
        "scripts/smoke.py"
      ],
      "timeout_seconds": 120,
      "run_at": [
        "pre-push",
        "check",
        "release-build"
      ]
    },
    "commit-message": {
      "id": "commit-message",
      "description": "Validate the final Git commit message",
      "enabled": true,
      "command": [
        "python3",
        "scripts/check-commits.py",
        "--message"
      ],
      "timeout_seconds": 30,
      "run_at": [
        "commit-msg"
      ]
    },
    "commit-range": {
      "id": "commit-range",
      "description": "Validate CI commits and pull request title",
      "enabled": true,
      "command": [
        "python3",
        "scripts/check-commits.py"
      ],
      "timeout_seconds": 60,
      "run_at": [
        "check"
      ]
    },
    "workflows": {
      "id": "workflows",
      "description": "Validate GitHub workflow syntax and expressions",
      "enabled": true,
      "command": [
        "actionlint",
        "-color"
      ],
      "timeout_seconds": 120,
      "run_at": [
        "pre-push",
        "check"
      ]
    },
    "msrv": {
      "id": "msrv",
      "description": "Check minimum supported Rust 1.85",
      "enabled": true,
      "command": [
        "cargo",
        "+1.85.0",
        "--offline",
        "check",
        "--all-targets",
        "--locked"
      ],
      "timeout_seconds": 600,
      "run_at": [
        "pre-push",
        "check"
      ]
    },
    "rust-audit": {
      "id": "rust-audit",
      "description": "Audit Rust dependencies",
      "enabled": true,
      "command": [
        "cargo",
        "+stable",
        "audit"
      ],
      "timeout_seconds": 300,
      "run_at": [
        "check"
      ]
    },
    "npm-audit": {
      "id": "npm-audit",
      "description": "Audit npm high and critical advisories",
      "enabled": true,
      "command": [
        "npm",
        "audit",
        "--audit-level=high"
      ],
      "timeout_seconds": 180,
      "run_at": [
        "check"
      ]
    },
    "release-artifacts": {
      "id": "release-artifacts",
      "description": "Verify the complete tested release artifact set",
      "enabled": true,
      "command": [
        "python3",
        "scripts/check-release-artifacts.py"
      ],
      "timeout_seconds": 180,
      "run_at": [
        "release-artifacts"
      ]
    }
  },
  "execution_points": {
    "commit-msg": [
      "commit-message"
    ],
    "pre-commit": [
      "format",
      "docs",
      "agents-size"
    ],
    "pre-push": [
      "format",
      "docs",
      "python-tests",
      "agents-size",
      "release-rules",
      "clippy",
      "rust-tests",
      "native-build",
      "native-smoke",
      "workflows",
      "msrv"
    ],
    "release-artifacts": [
      "release-artifacts"
    ],
    "check": [
      "format",
      "docs",
      "python-tests",
      "agents-size",
      "release-rules",
      "clippy",
      "rust-tests",
      "native-build",
      "native-smoke",
      "commit-range",
      "workflows",
      "msrv",
      "rust-audit",
      "npm-audit"
    ],
    "release-build": [
      "format",
      "clippy",
      "rust-tests",
      "native-build",
      "native-smoke"
    ]
  }
}
