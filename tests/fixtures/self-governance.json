{
  "checks": {
    "01-format": {
      "id": "01-format",
      "description": "Verify Rust formatting",
      "enabled": true,
      "command": [
        "cargo",
        "+stable",
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "timeout_seconds": 120,
      "run_at": [
        "pre-commit",
        "pre-push",
        "check",
        "release-build"
      ]
    },
    "02-docs": {
      "id": "02-docs",
      "description": "Validate documentation links and specification references",
      "enabled": true,
      "command": [
        "python3",
        "scripts/check-docs.py"
      ],
      "timeout_seconds": 60,
      "run_at": [
        "pre-commit",
        "pre-push",
        "check"
      ]
    },
    "03-python-tests": {
      "id": "03-python-tests",
      "description": "Test Python helpers and repository integration",
      "enabled": true,
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts",
        "-p",
        "test_*.py"
      ],
      "timeout_seconds": 300,
      "run_at": [
        "pre-push",
        "check"
      ]
    },
    "04-agents-size": {
      "id": "04-agents-size",
      "description": "Limit AGENTS.md to 1200 ASCII-whitespace-separated words",
      "enabled": true,
      "command": [
        "python3",
        "scripts/check-word-count.py",
        "AGENTS.md",
        "1200"
      ],
      "timeout_seconds": 30,
      "run_at": [
        "pre-commit",
        "pre-push",
        "check"
      ]
    },
    "08-release-rules": {
      "id": "08-release-rules",
      "description": "Test semantic release rules and lifecycle",
      "enabled": true,
      "command": [
        "npm",
        "--offline",
        "test"
      ],
      "timeout_seconds": 180,
      "run_at": [
        "pre-push",
        "check"
      ]
    },
    "10-clippy": {
      "id": "10-clippy",
      "description": "Lint Rust with warnings denied",
      "enabled": true,
      "command": [
        "cargo",
        "+stable",
        "--offline",
        "clippy",
        "--all-targets",
        "--locked",
        "--",
        "-D",
        "warnings"
      ],
      "timeout_seconds": 600,
      "run_at": [
        "pre-push",
        "check",
        "release-build"
      ]
    },
    "11-rust-tests": {
      "id": "11-rust-tests",
      "description": "Run unit acceptance documentation and compatibility tests",
      "enabled": true,
      "command": [
        "cargo",
        "+stable",
        "--offline",
        "test",
        "--locked"
      ],
      "timeout_seconds": 600,
      "run_at": [
        "pre-push",
        "check",
        "release-build"
      ]
    },
    "12-native-build": {
      "id": "12-native-build",
      "description": "Build the candidate native release executable",
      "enabled": true,
      "command": [
        "cargo",
        "+stable",
        "build",
        "--release",
        "--locked",
        "--offline"
      ],
      "timeout_seconds": 600,
      "run_at": [
        "pre-push",
        "check",
        "release-build"
      ]
    },
    "13-native-smoke": {
      "id": "13-native-smoke",
      "description": "Smoke-test the candidate executable",
      "enabled": true,
      "command": [
        "python3",
        "scripts/smoke.py"
      ],
      "timeout_seconds": 120,
      "run_at": [
        "pre-push",
        "check",
        "release-build"
      ]
    },
    "20-commit-message": {
      "id": "20-commit-message",
      "description": "Validate the final Git commit message",
      "enabled": true,
      "command": [
        "python3",
        "scripts/check-commits.py",
        "--message"
      ],
      "timeout_seconds": 30,
      "run_at": [
        "commit-msg"
      ]
    },
    "21-commit-range": {
      "id": "21-commit-range",
      "description": "Validate CI commits and pull request title",
      "enabled": true,
      "command": [
        "python3",
        "scripts/check-commits.py"
      ],
      "timeout_seconds": 60,
      "run_at": [
        "check"
      ]
    },
    "22-workflows": {
      "id": "22-workflows",
      "description": "Validate GitHub workflow syntax and expressions",
      "enabled": true,
      "command": [
        "actionlint",
        "-color"
      ],
      "timeout_seconds": 120,
      "run_at": [
        "pre-push",
        "check"
      ]
    },
    "23-msrv": {
      "id": "23-msrv",
      "description": "Check minimum supported Rust 1.85",
      "enabled": true,
      "command": [
        "cargo",
        "+1.85.0",
        "--offline",
        "check",
        "--all-targets",
        "--locked"
      ],
      "timeout_seconds": 600,
      "run_at": [
        "pre-push",
        "check"
      ]
    },
    "24-rust-audit": {
      "id": "24-rust-audit",
      "description": "Audit Rust dependencies",
      "enabled": true,
      "command": [
        "cargo",
        "+stable",
        "audit"
      ],
      "timeout_seconds": 300,
      "run_at": [
        "check"
      ]
    },
    "25-npm-audit": {
      "id": "25-npm-audit",
      "description": "Audit npm high and critical advisories",
      "enabled": true,
      "command": [
        "npm",
        "audit",
        "--audit-level=high"
      ],
      "timeout_seconds": 180,
      "run_at": [
        "check"
      ]
    },
    "30-release-artifacts": {
      "id": "30-release-artifacts",
      "description": "Verify the complete tested release artifact set",
      "enabled": true,
      "command": [
        "python3",
        "scripts/check-release-artifacts.py"
      ],
      "timeout_seconds": 180,
      "run_at": [
        "release-artifacts"
      ]
    }
  },
  "execution_points": {
    "commit-msg": [
      "20-commit-message"
    ],
    "pre-commit": [
      "01-format",
      "02-docs",
      "04-agents-size"
    ],
    "pre-push": [
      "01-format",
      "02-docs",
      "03-python-tests",
      "04-agents-size",
      "08-release-rules",
      "10-clippy",
      "11-rust-tests",
      "12-native-build",
      "13-native-smoke",
      "22-workflows",
      "23-msrv"
    ],
    "release-artifacts": [
      "30-release-artifacts"
    ],
    "check": [
      "01-format",
      "02-docs",
      "03-python-tests",
      "04-agents-size",
      "08-release-rules",
      "10-clippy",
      "11-rust-tests",
      "12-native-build",
      "13-native-smoke",
      "21-commit-range",
      "22-workflows",
      "23-msrv",
      "24-rust-audit",
      "25-npm-audit"
    ],
    "release-build": [
      "01-format",
      "10-clippy",
      "11-rust-tests",
      "12-native-build",
      "13-native-smoke"
    ]
  }
}
